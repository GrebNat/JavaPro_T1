<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="DataSourceConfig" class="org.example.config.DataSourceConfig"/>
    <bean id="UserDao" class="org.example.ioc.UserDao">
        <constructor-arg name="dataSourceConfig" ref="DataSourceConfig"/>
    </bean>
    <bean id="UserService" class="org.example.ioc.UserService">
        <constructor-arg name="userDao" ref="UserDao"/>
    </bean>
</beans>
